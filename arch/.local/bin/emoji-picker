#!/usr/bin/env python3

import shutil
import subprocess
import tempfile
import time

import picker.standalone as st
from picker.models import Action

import picker.selector.fuzzel as fuzzel_mod
from pathlib import Path

_real_show = fuzzel_mod.Fuzzel.show_character_selection

def patched_show_character_selection(
    self,
    characters,
    recent_characters,
    prompt,
    show_description,
    use_icons,
    keybindings,
    additional_args,
):
    config = Path.home() / ".config" / "fuzzel" / "emoji.ini"

    additional_args = [
        "--config",
        str(config),
        *additional_args,
    ]

    return _real_show(
        self,
        characters,
        recent_characters,
        prompt,
        show_description,
        use_icons,
        keybindings,
        additional_args,
    )


fuzzel_mod.Fuzzel.show_character_selection = patched_show_character_selection

_real_execute = st.execute_action


def run(*args, input=None, stdin=None, stdout=None, stderr=None, check=True):
    return subprocess.run(
        args,
        input=input,
        stdin=stdin,
        stdout=stdout,
        stderr=stderr,
        check=check,
    )


def patch_execute(characters, actions, active_window, typer, clipboarder):
    """
    Intercept actions that would normally type characters.
    Instead:
      1. Save clipboard/primary.
      2. Copy emoji.
      3. Paste with Ctrl+V.
      4. Restore clipboard/primary.
      5. Restore cliphist ordering.
    """
    
    typing_actions = {
        Action.TYPE,
        getattr(Action, "TYPE_CLIPBOARD", None),
    }

    if not any(action in typing_actions for action in actions):
        return _real_execute(
            characters,
            actions,
            active_window,
            typer,
            clipboarder,
        )

    with tempfile.TemporaryDirectory() as tmpdir:
        clip = f"{tmpdir}/clipboard"
        primary = f"{tmpdir}/primary"

        with open(clip, "wb") as f:
            subprocess.run(
                ["wl-paste", "--no-newline"],
                stdout=f,
                stderr=subprocess.DEVNULL,
            )

        with open(primary, "wb") as f:
            subprocess.run(
                ["wl-paste", "--primary", "--no-newline"],
                stdout=f,
                stderr=subprocess.DEVNULL,
            )

        try:
            run("wl-copy", input=characters.encode())

            # Allow the clipboard owner to update.
            time.sleep(0.05)

            run("wtype", "-M", "ctrl", "-k", "v", "-m", "ctrl")

            # Give Chromium a chance to consume the paste.
            time.sleep(0.05)

        finally:
            with open(clip, "rb") as f:
                subprocess.run(["wl-copy"], stdin=f)

            with open(primary, "rb") as f:
                subprocess.run(["wl-copy", "--primary"], stdin=f)

            # Restore cliphist ordering if installed.
            if shutil.which("cliphist"):
                with open(clip, "rb") as f:
                    subprocess.run(
                        ["cliphist", "store"],
                        stdin=f,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )


st.execute_action = patch_execute

if __name__ == "__main__":
    st.StandaloneRofimoji().standalone()
