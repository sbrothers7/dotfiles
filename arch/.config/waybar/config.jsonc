{
    "layer": "bottom",   // statbar (workspaces + stats) sits above on the top layer
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [],    // workspaces are drawn by ~/.config/waybar/statbar

    "modules-center": [
        "clock"
    ],

    "modules-right": [],   // stats are drawn by ~/.config/waybar/statbar

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d  %H:%M}",
        "tooltip": false
    }
}
