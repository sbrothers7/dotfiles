diff --git a/plug-ins/python/scribble-settings.py b/plug-ins/python/scribble-settings.py
new file mode 100755
index 0000000..fce70de
--- /dev/null
+++ b/plug-ins/python/scribble-settings.py
@@ -0,0 +1,203 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+#   GIMP - The GNU Image Manipulation Program
+#
+#   This program is free software: you can redistribute it and/or modify
+#   it under the terms of the GNU General Public License as published by
+#   the Free Software Foundation; either version 3 of the License, or
+#   (at your option) any later version.
+#
+#   This program is distributed in the hope that it will be useful,
+#   but WITHOUT ANY WARRANTY; without even the implied warranty of
+#   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+#   GNU General Public License for more details.
+#
+#   You should have received a copy of the GNU General Public License
+#   along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+# Edit > Scribble Settings: edits scribble.ini in the GIMP profile, which the
+# paint tools' scribble-to-erase (app/tools/gimppainttool-scribble.c) re-reads
+# whenever it changes.  The defaults here must match the ones there.
+
+import os
+import sys
+
+import gi
+gi.require_version('Gimp', '3.0')
+from gi.repository import Gimp
+gi.require_version('GimpUi', '3.0')
+from gi.repository import GimpUi
+gi.require_version('Gtk', '3.0')
+from gi.repository import Gtk
+from gi.repository import GLib
+from gi.repository import GObject
+
+PROC_NAME = 'plug-in-scribble-settings'
+GROUP = 'scribble'
+
+# key, label, tooltip, default, min, max, step, digits
+BASIC = [
+    ('passes', 'Passes needed',
+     'How many back-and-forth passes in a row make a scribble.', 5, 2, 50, 1, 0),
+    ('pass_min_mm', 'Shortest pass (mm)',
+     'Passes shorter than this (in mm of pen travel) don\'t count.', 1.5, 0, 500, 0.5, 1),
+    ('pass_seconds', 'Slowest pass (s)',
+     'Median time per pass. Slower zig-zags are drawing (hatching), not scribbling.', 0.35, 0.01, 10, 0.05, 2),
+    ('px_per_mm', 'Screen pixels per tablet mm',
+     'How many screen pixels one millimetre of pen travel covers; converts the mm values above.', 12.0, 0.1, 1000, 0.5, 1),
+]
+ADVANCED = [
+    ('turn_angle', 'Turn-back angle (°)',
+     'Consecutive passes must point at least this far apart (180 = straight back over the same line). '
+     'Lower is more sensitive, but zig-zags drifting sideways start to look like fast "iiii" handwriting.',
+     152.0, 90, 180, 1, 0),
+    ('parallel_angle', 'Parallel tolerance (°)',
+     'Every other pass must point within this angle of the one two before it.', 26.0, 0, 90, 1, 0),
+    ('straightness', 'Pass straightness',
+     'A pass\'s end-to-end distance divided by its path length (1 = perfectly straight). '
+     'Handwriting arches and loops score low.', 0.85, 0, 1, 0.05, 2),
+    ('length_ratio', 'Pass length ratio',
+     'Consecutive passes may differ in length by at most this factor.', 2.0, 1, 100, 0.1, 1),
+    ('pass_max_mm', 'Longest pass (mm)', 'Passes longer than this don\'t count.', 60.0, 0, 500, 1, 0),
+    ('cusp_angle', 'Turn sharpness (°)',
+     'A change of direction sharper than this ends one pass and starts the next.', 135.0, 45, 180, 1, 0),
+    ('cusp_mm', 'Turn measuring distance (mm)',
+     'How far before and after a point the change of direction is measured.', 1.5, 0.1, 50, 0.1, 1),
+    ('step_mm', 'Path resampling (mm)', 'The stroke is resampled every this many mm before analysing it.',
+     0.5, 0.05, 10, 0.05, 2),
+    ('hit_margin_px', 'Hit margin (px)',
+     'A stroke is erased when the scribble comes within its brush radius plus this many image pixels.',
+     2.0, 0, 500, 1, 0),
+    ('history', 'Strokes remembered',
+     'How many recent strokes per image can be scribbled away.', 100, 1, 10000, 10, 0),
+]
+
+
+def settings_path():
+    return os.path.join(Gimp.directory(), 'scribble.ini')
+
+
+def load():
+    values = {'enabled': True}
+    values.update({f[0]: f[3] for f in BASIC + ADVANCED})
+    keyfile = GLib.KeyFile()
+    try:
+        keyfile.load_from_file(settings_path(), GLib.KeyFileFlags.NONE)
+    except GLib.Error:
+        return values
+    for key in values:
+        try:
+            v = keyfile.get_double(GROUP, key)
+        except GLib.Error:
+            continue
+        values[key] = v != 0 if key == 'enabled' else v
+    return values
+
+
+def save(values):
+    keyfile = GLib.KeyFile()
+    keyfile.set_comment(None, None,
+                        ' Scribble to erase (Edit > Scribble Settings). Angles in degrees, lengths in mm of pen travel.')
+    keyfile.set_integer(GROUP, 'enabled', 1 if values['enabled'] else 0)
+    for key, *_, digits in BASIC + ADVANCED:
+        keyfile.set_string(GROUP, key, f'{values[key]:.{digits}f}')
+    keyfile.save_to_file(settings_path())
+
+
+def add_rows(grid, fields, values, spins):
+    for row, (key, label, tooltip, default, lo, hi, step, digits) in enumerate(fields):
+        name = Gtk.Label(label=label, xalign=0.0)
+        name.set_tooltip_text(tooltip)
+        adj = Gtk.Adjustment(value=values[key], lower=lo, upper=hi,
+                             step_increment=step, page_increment=step * 10)
+        spin = Gtk.SpinButton(adjustment=adj, digits=digits, numeric=True)
+        spin.set_tooltip_text(tooltip)
+        spin.set_hexpand(True)
+        grid.attach(name, 0, row, 1, 1)
+        grid.attach(spin, 1, row, 1, 1)
+        spins[key] = (spin, default)
+
+
+def run(procedure, config, data):
+    GimpUi.init(PROC_NAME)
+    values = load()
+
+    use_header_bar = Gtk.Settings.get_default().get_property('gtk-dialogs-use-header')
+    dialog = GimpUi.Dialog(use_header_bar=use_header_bar, title='Scribble Settings', role=PROC_NAME)
+    dialog.add_button('_Reset', Gtk.ResponseType.REJECT)
+    dialog.add_button('_Cancel', Gtk.ResponseType.CANCEL)
+    dialog.add_button('_OK', Gtk.ResponseType.OK)
+    dialog.set_default_response(Gtk.ResponseType.OK)
+
+    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, border_width=12)
+    dialog.get_content_area().pack_start(box, True, True, 0)
+
+    intro = Gtk.Label(xalign=0.0, wrap=True, max_width_chars=48,
+                      label='Scribble quickly back and forth over strokes with the paintbrush or '
+                            'pencil to erase them. Changes apply to the next stroke.')
+    box.pack_start(intro, False, False, 0)
+
+    enabled = Gtk.CheckButton(label='_Scribble to erase', use_underline=True, active=values['enabled'])
+    box.pack_start(enabled, False, False, 0)
+
+    spins = {}
+    basic = Gtk.Grid(row_spacing=6, column_spacing=12)
+    add_rows(basic, BASIC, values, spins)
+    box.pack_start(basic, False, False, 0)
+
+    expander = Gtk.Expander(label='_Advanced', use_underline=True, expanded=False)
+    advanced = Gtk.Grid(row_spacing=6, column_spacing=12, margin_top=6)
+    add_rows(advanced, ADVANCED, values, spins)
+    expander.add(advanced)
+    box.pack_start(expander, False, False, 0)
+
+    def sensitivity(*_):
+        basic.set_sensitive(enabled.get_active())
+        expander.set_sensitive(enabled.get_active())
+    enabled.connect('toggled', sensitivity)
+    sensitivity()
+
+    dialog.show_all()
+    while True:
+        response = dialog.run()
+        if response == Gtk.ResponseType.REJECT:
+            enabled.set_active(True)
+            for spin, default in spins.values():
+                spin.set_value(default)
+            continue
+        if response == Gtk.ResponseType.OK:
+            values['enabled'] = enabled.get_active()
+            for key, (spin, _) in spins.items():
+                spin.update()
+                values[key] = spin.get_value()
+            try:
+                save(values)
+            except GLib.Error as error:
+                dialog.destroy()
+                return procedure.new_return_values(Gimp.PDBStatusType.EXECUTION_ERROR,
+                                                   GLib.Error(error.message))
+        break
+
+    dialog.destroy()
+    return procedure.new_return_values(Gimp.PDBStatusType.SUCCESS, GLib.Error())
+
+
+class ScribbleSettings(Gimp.PlugIn):
+    def do_query_procedures(self):
+        return [PROC_NAME]
+
+    def do_create_procedure(self, name):
+        procedure = Gimp.Procedure.new(self, name, Gimp.PDBProcType.PLUGIN, run, None)
+        procedure.set_menu_label('Scri_bble Settings...')
+        procedure.set_documentation('Tune scribble to erase',
+                                    'Thresholds for erasing paintbrush and pencil strokes by scribbling over them',
+                                    name)
+        procedure.set_attribution('sbrothers7', 'sbrothers7', '2026')
+        procedure.add_enum_argument('run-mode', 'Run mode', 'The run mode', Gimp.RunMode,
+                                    Gimp.RunMode.INTERACTIVE, GObject.ParamFlags.READWRITE)
+        procedure.add_menu_path('<Image>/Edit')
+        return procedure
+
+
+Gimp.main(ScribbleSettings.__gtype__, sys.argv)
