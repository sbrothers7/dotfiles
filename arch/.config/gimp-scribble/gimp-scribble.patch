+
+/*  Scribble to erase: paintbrush/pencil/eraser strokes are recorded, and a
+ *  fast in-place zig-zag drawn with the paintbrush or pencil removes the
+ *  recorded strokes it crosses (later strokes are replayed on top), like
+ *  GoodNotes.  Set GIMP_SCRIBBLE=0 to disable.
+ */
+
+void   gimp_paint_tool_scribble_start  (GimpPaintTool    *paint_tool,
